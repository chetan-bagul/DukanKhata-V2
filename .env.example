# Local IntelliJ run settings. Use platform-managed secrets in production.
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/dukankhata
DB_USERNAME=dukankhata
DB_PASSWORD=change-this-local-only
DB_POOL_SIZE=5
DB_MIN_IDLE=1
JPA_DDL_AUTO=update
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

# Replace locally with a random value of at least 32 bytes; never reuse in production.
JWT_SECRET=replace-with-a-random-local-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5175
SECURITY_RATE_LIMIT_LOGIN_CAPACITY=5
SECURITY_RATE_LIMIT_LOGIN_REFILL_INTERVAL_MS=12000
SECURITY_RATE_LIMIT_LOGIN_STATE_TTL_MS=120000

NOTIFICATION_WORKER_FIXED_DELAY_MS=5000
NOTIFICATION_WORKER_LEASE_DURATION_MS=300000
NOTIFICATION_WORKER_MAX_ATTEMPTS=5
SLOW_REQUEST_MS=1000

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_SMALL_MONTHLY=150
SUBSCRIPTION_SMALL_YEARLY=1500
SUBSCRIPTION_LARGE_MONTHLY=199
SUBSCRIPTION_LARGE_YEARLY=1990
